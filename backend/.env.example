# Server Configuration
PORT=4000
NODE_ENV=development

# Comma-separated list of allowed browser/client origins (Expo Web defaults to http://localhost:8081)
CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081

# Supabase Cloud Project Credentials (Project Settings -> API)
SUPABASE_PROJECT_ID=your_supabase_project_ref_id
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_or_publishable_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_or_secret_key
